{
  "name": "@sebastienrousseau/mocha-config",
  "version": "0.0.4",
  "description": "Shareable Mocha test runner configuration files and rules",
  "author": "Sebastien Rousseau <sebastienrousseau@users.noreply.github.com>",
  "license": "Apache-2.0 OR MIT",
  "homepage": "https://github.com/sebastienrousseau/mocha-config#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sebastienrousseau/mocha-config.git"
  },
  "bugs": {
    "url": "https://github.com/sebastienrousseau/mocha-config/issues"
  },
  "keywords": [
    "mocha",
    "mocharc",
    "test-runner",
    "testing"
  ],
  "main": "./index.cjs",
  "module": "./index.mjs",
  "types": "./index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "import": "./index.mjs",
      "require": "./index.cjs"
    }
  },
  "files": [
    "index.js",
    "index.mjs",
    "index.cjs",
    "index.d.ts",
    "mocha-config.svg",
    "LICENSE",
    ".editorconfig"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "test": "node --test --experimental-test-coverage --test-coverage-lines=98 --test-coverage-branches=98 --test-coverage-functions=98 tests/unit.test.js tests/integration.test.js tests/bench.test.js",
    "test:coverage": "node --test --experimental-test-coverage --test-coverage-lines=98 --test-coverage-branches=98 --test-coverage-functions=98 tests/unit.test.js tests/integration.test.js tests/bench.test.js",
    "bench": "node benches/bench_load.js",
    "examples": "node examples/basic.js && node examples/advanced.js && node examples/features.js && node examples/esm.mjs",
    "docs:build": "bash scripts/build-docs.sh"
  },
  "peerDependencies": {
    "mocha": ">=10.0.0"
  },
  "devDependencies": {
    "mocha": "^12.0.0"
  },
  "overrides": {
    "brace-expansion@>=2.0.0 <2.1.4": ">=2.1.4 <3.0.0",
    "serialize-javascript@<=7.0.4": ">=7.0.5 <8.0.0"
  }
}
